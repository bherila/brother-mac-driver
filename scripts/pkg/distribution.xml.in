<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>brother-mac-driver @VERSION@</title>
    <options hostArchitectures="arm64" rootVolumeOnly="true"/>
    <allowed-os-versions>
        <os-version min="26.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="@PKG_ID@"/>
    </choices-outline>
    <choice id="@PKG_ID@" visible="false">
        <pkg-ref id="@PKG_ID@"/>
    </choice>
    <pkg-ref id="@PKG_ID@" version="@VERSION@" onConclusion="none">@COMPONENT_PKG@</pkg-ref>
</installer-gui-script>
